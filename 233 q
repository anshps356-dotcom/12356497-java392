
class Solution {
public:
    int countDigitOne(int n) {
        long long count = 0;

        for (long long i = 1; i <= n; i *= 10) {
            long long divider = i * 10;

            count += (n / divider) * i;

            long long remainder = n % divider;

            if (remainder >= i) {
                count += min(remainder - i + 1, i);
            }
        }

        return count;
    }
};
